# Example Environment Variables for User Authentication System
# Copy to .env for local testing or configure as Environment Variables in Render Dashboard

# Server Port (Render injects PORT automatically)
PORT=8080

# Neon PostgreSQL Connection Settings
# Format: jdbc:postgresql://<neon-host>/<database-name>?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://ep-example.region.aws.neon.tech/neondb?sslmode=require
SPRING_DATASOURCE_USERNAME=neondb_owner
SPRING_DATASOURCE_PASSWORD=your_neon_database_password
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver

# JPA / Hibernate Schema Behavior
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# JWT Security Configuration (Secret MUST be at least 32 characters / 256 bits)
JWT_SECRET=replace_with_a_secure_random_at_least_32_characters_secret_key_here
JWT_EXPIRATION_MS=900000

# Application Configuration
# APP_DEMO_MODE=false in production (prevents exposure of tokens in responses)
APP_DEMO_MODE=false
# Leave empty for same-origin browser access (recommended)
CORS_ALLOWED_ORIGINS=
